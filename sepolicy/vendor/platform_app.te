binder_call(platform_app, hal_camera_default)

allow platform_app hal_camera_transfer_service:service_manager find;

get_prop(platform_app, vendor_zte_prop)
# PlasmaOS: platform_app_36 camera (NubiaCamera API 36)
binder_call(platform_app_36, hal_camera_default)
allow platform_app_36 hal_camera_transfer_service:service_manager find;
get_prop(platform_app_36, vendor_zte_prop)

